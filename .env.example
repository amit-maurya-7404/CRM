# MongoDB Atlas Free M0 Cluster URI (Optional for instant demo, required for permanent cloud DB)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nexus_crm?retryWrites=true&w=majority
MONGODB_URI=

# Optional: NextAuth Secret
NEXTAUTH_SECRET=crm_super_secret_jwt_key_2026_change_in_production
NEXTAUTH_URL=http://localhost:3000
